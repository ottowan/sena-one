rules_version = '2';

service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrOwner() {
      return isSignedIn() && userRole() in ['admin', 'owner'];
    }

    function isTenant() {
      return isSignedIn() && userRole() == 'tenant';
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsRoom(roomId) {
      return get(/databases/$(db)/documents/rooms/$(roomId)).data.current_tenant_uid == request.auth.uid;
    }

    // Login resolution: username/phone -> {uid, email}. Must be readable
    // by exact key before the caller is signed in; never listable.
    match /username_lookup/{username} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdminOrOwner();
    }

    match /phone_lookup/{phone} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdminOrOwner();
    }

    // Login identity + role. Merges the old `users`+`profiles` tables.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdminOrOwner();
      allow create: if isAdminOrOwner();
      // A resident must not be able to promote their own role to open surveys.
      allow update: if isAdminOrOwner() || (isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'full_name', 'phone', 'email', 'id_card_number', 'id_card_image_url', 'updated_at'
        ]));
      allow delete: if isAdminOrOwner();
    }

    match /app_settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrOwner();
    }

    match /position_rent_rates/{level} {
      allow read: if isSignedIn();
      allow write: if isAdminOrOwner();
    }

    match /rooms/{roomId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.current_tenant_uid == request.auth.uid);
      allow write: if isAdminOrOwner();
    }

    match /tenants/{tenantId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.user_id == request.auth.uid);
      allow write: if isAdminOrOwner();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && ownsRoom(resource.data.room_id));
      allow write: if isAdminOrOwner();
    }

    match /equipment_survey_rounds/{year} {
      allow read: if isAdminOrOwner() || isTenant();
      allow create: if isAdminOrOwner()
        && request.resource.data.keys().hasOnly(['year', 'status', 'room_count', 'opened_at', 'opened_by'])
        && request.resource.data.year is int && request.resource.data.year == int(year)
        && request.resource.data.year >= 2000 && request.resource.data.year <= 2100
        && request.resource.data.status == 'open'
        && request.resource.data.room_count is int && request.resource.data.room_count > 0 && request.resource.data.room_count <= 450
        && request.resource.data.opened_at == request.time && request.resource.data.opened_by == request.auth.uid;
      allow update: if isAdminOrOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'updated_by'])
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.updated_at == request.time && request.resource.data.updated_by == request.auth.uid;
      allow delete: if false;
      match /rooms/{roomId} {
        function canAnswer() {
          return isTenant() && ownsRoom(roomId)
            && resource.data.status == 'pending'
            && get(/databases/$(db)/documents/equipment_survey_rounds/$(year)).data.status == 'open';
        }
        function advancesOneAnswer() {
          let id = request.resource.data.last_answer_id;
          let answerPath = /databases/$(db)/documents/equipment_survey_rounds/$(year)/rooms/$(roomId)/responses/$(id);
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answered_count', 'last_answer_id'])
            && id in resource.data.item_ids
            && request.resource.data.answered_count == resource.data.answered_count + 1
            && !exists(answerPath)
            && getAfter(answerPath).data.equipment_id == id;
        }
        function finalSubmission() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submitted_at', 'submitted_by', 'submitted_by_name'])
            && request.resource.data.status == 'submitted'
            && resource.data.answered_count == resource.data.item_ids.size()
            && request.resource.data.submitted_by == request.auth.uid
            && request.resource.data.submitted_by_name == get(/databases/$(db)/documents/users/$(request.auth.uid)).data.get('full_name', '')
            && request.resource.data.submitted_at == request.time;
        }
        allow read: if isAdminOrOwner() || (isTenant() && ownsRoom(roomId));
        allow create: if isAdminOrOwner()
          && !exists(/databases/$(db)/documents/equipment_survey_rounds/$(year))
          && getAfter(/databases/$(db)/documents/equipment_survey_rounds/$(year)).data.status == 'open'
          && request.resource.data.room_id == roomId && request.resource.data.year == int(year)
          && request.resource.data.status == 'pending' && request.resource.data.answers == []
          && request.resource.data.items is list && request.resource.data.items.size() > 0
          && request.resource.data.item_ids is list
          && request.resource.data.item_ids.size() == request.resource.data.items.size()
          && request.resource.data.item_ids.toSet().size() == request.resource.data.item_ids.size()
          && request.resource.data.answered_count == 0
          && request.resource.data.created_at == request.time;
        allow update: if canAnswer() && (advancesOneAnswer() || finalSubmission());
        allow delete: if false;

        match /responses/{itemId} {
          function validResponse() {
            let answer = request.resource.data;
            let parent = get(/databases/$(db)/documents/equipment_survey_rounds/$(year)/rooms/$(roomId)).data;
            return isTenant() && ownsRoom(roomId)
              && parent.status == 'pending'
              && getAfter(/databases/$(db)/documents/equipment_survey_rounds/$(year)/rooms/$(roomId)).data.status == 'pending'
              && get(/databases/$(db)/documents/equipment_survey_rounds/$(year)).data.status == 'open'
              && itemId in parent.item_ids
              && answer.keys().hasOnly(['equipment_id', 'condition', 'reason', 'answered_by', 'updated_at'])
              && answer.equipment_id == itemId
              && answer.answered_by == request.auth.uid && answer.updated_at == request.time
              && answer.condition in ['normal', 'damaged', 'deteriorated', 'lost', 'unnecessary']
              && answer.reason is string && answer.reason.size() <= 2000
              && (answer.condition == 'normal' || (answer.reason.trim().size() >= 2 && !(answer.reason.trim() in ['-', '_', '0', 'ปกติ'])));
          }
          allow read: if isAdminOrOwner() || (isTenant() && ownsRoom(roomId));
          allow create: if validResponse()
            && getAfter(/databases/$(db)/documents/equipment_survey_rounds/$(year)/rooms/$(roomId)).data.last_answer_id == itemId
            && getAfter(/databases/$(db)/documents/equipment_survey_rounds/$(year)/rooms/$(roomId)).data.answered_count
              == get(/databases/$(db)/documents/equipment_survey_rounds/$(year)/rooms/$(roomId)).data.answered_count + 1;
          allow update: if validResponse();
          allow delete: if false;
        }
      }
    }

    match /contracts/{contractId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.tenant_uid == request.auth.uid);
      allow write: if isAdminOrOwner();
    }

    match /invoices/{invoiceId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.tenant_uid == request.auth.uid);
      allow write: if isAdminOrOwner();
    }

    match /payments/{paymentId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.tenant_uid == request.auth.uid);
      // Tenants never create payments directly (mirrors old tenantCanMutate,
      // which never allowed tenant-initiated payment writes).
      allow write: if isAdminOrOwner();
    }

    match /deposits/{depositId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.tenant_uid == request.auth.uid);
      allow write: if isAdminOrOwner();
    }

    match /maintenance_requests/{requestId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && resource.data.tenant_uid == request.auth.uid);
      allow create: if isAdminOrOwner() ||
        (isTenant()
          && request.resource.data.tenant_uid == request.auth.uid
          && ownsRoom(request.resource.data.room_id));
      // Tenants may never update/delete, even their own requests - matches
      // old tenantCanMutate, which only ever allowed `insert`.
      allow update, delete: if isAdminOrOwner();
    }

    match /history_meter/{docId} {
      allow read: if isAdminOrOwner() ||
        (isTenant() && ownsRoom(resource.data.room_id));
      allow create, update: if isAdminOrOwner() ||
        (isTenant() && ownsRoom(request.resource.data.room_id));
      allow delete: if isAdminOrOwner();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isAdminOrOwner() ||
        (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isAdminOrOwner() ||
        (isSignedIn() && request.resource.data.user_id == request.auth.uid);
    }

    // Legacy/unused (no service references these today) - admin-only.
    match /bookings/{bookingId} {
      allow read, write: if isAdminOrOwner();
    }
  }
}
