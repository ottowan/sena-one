# Frontend
# Leave empty when frontend and backend are served from the same origin.
# Set this when deploying the frontend separately, such as Netlify + external API server.
VITE_API_BASE=

# Backend
PORT=3000
NODE_ENV=production
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=https://sena-one.netlify.app
SQLITE_DB_PATH=./data/sena-one.sqlite
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760

# First-run bootstrap admin.
# Used only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PHONE=admin
ADMIN_FULL_NAME=Administrator
ADMIN_PASSWORD=replace-before-deploy
