# Firebase web app config (not secret - see https://firebase.google.com/docs/projects/api-keys)
# Get these from Firebase Console > Project settings > General > Your apps > SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Used once by scripts/migrate-to-firestore.ts (local-only, never deployed).
# Point this at a downloaded service-account JSON key, or omit to use
# `gcloud auth application-default login` credentials instead.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
